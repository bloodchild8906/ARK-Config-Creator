# Normalise line endings so the same file does not appear modified purely
# because it was written on a different platform.
#
# The legal .txt documents are generated by `npm run legal` (tools/gen-legal.js)
# and are deliberately written with CRLF and a UTF-8 BOM, because Notepad and
# the NSIS licence page need both. Storing them as LF and checking them out as
# CRLF gives that result on Windows without every regeneration showing up as a
# whole-file diff.

* text=auto

*.txt   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

*.png   binary
*.ico   binary
*.bmp   binary
